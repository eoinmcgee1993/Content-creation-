{
  "mcpServers": {
    "notebooklm": {
      "command": "notebooklm-mcp",
      "args": [],
      "env": {}
    },
    "muapi": {
      "type": "http",
      "url": "https://api.muapi.ai/mcp"
    },
    "open-video": {
      "type": "http",
      "url": "https://mcp.open.video/mcp"
    },
    "open-video-upload": {
      "command": "npx",
      "args": [
        "-y",
        "open-video-upload-helper"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/setup.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r \".tool_response.filePath // .tool_input.file_path\" | { read -r f; case \"$f\" in */substack-os/*.js) out=$(cd \"${CLAUDE_PROJECT_DIR:-.}/substack-os\" && npm test 2>&1) || { printf \"%s\\n\" \"$out\" | tail -30 >&2; exit 2; };; esac; }",
            "timeout": 120,
            "statusMessage": "Running substack-os tests"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "anti-slop": {
      "source": {
        "source": "github",
        "repo": "miqdadbadjuber/anti-slop"
      }
    }
  },
  "enabledPlugins": {
    "antislop@anti-slop": true
  }
}
